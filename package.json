{
  "name": "personal-accompanist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A piano accompanist for singers who don't play piano.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:full": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply score-to-sound --remote",
    "db:migrate:local": "wrangler d1 migrations apply score-to-sound --local"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pdfjs-dist": "3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tone": "14.7.77",
    "vexflow": "4.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.3",
    "vite": "5.4.10",
    "wrangler": "4.149.0"
  }
}
